# VITE_ prefiksi olanlar frontend tərəfindən Vite vasitəsilə oxunur
VITE_SUPABASE_URL=https://<YOUR_PROJECT_ID>.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Yalnız backend tərəfindən istifadə edilir (service_role) - Heç vaxt frontendə keçməməlidir
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Vercel cron endpoints üçün mühafizə sirri
CRON_SECRET=your-random-cron-secret-here

# AbuseIPDB API key (backend only)
ABUSEIPDB_API_KEY=your-abuseipdb-api-key-here

# OTX (AlienVault Open Threat Exchange) API key (backend only)
OTX_API_KEY=your-otx-api-key-here

# VirusTotal API key (backend only)
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here

# Abuse.ch Hunting API auth key (backend only)
ABUSE_CH_AUTH_KEY=your-abuse-ch-auth-key-here

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Allowed IP addresses for cron endpoints (comma-separated, optional)
# Leave empty to disable IP whitelisting (not recommended for production)
ALLOWED_CRON_IPS=
