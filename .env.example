# VITE_ prefiksi olanlar frontend tərəfindən Vite vasitəsilə oxunur
VITE_SUPABASE_URL=https://<YOUR_PROJECT_ID>.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Yalnız backend tərəfindən istifadə edilir (service_role) - Heç vaxt frontendə keçməməlidir
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Vercel cron endpoints üçün mühafizə sirri
CRON_SECRET=your-random-cron-secret-here

# AbuseIPDB API key (backend only)
ABUSEIPDB_API_KEY=your-abuseipdb-api-key-here

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
