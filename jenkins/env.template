# Jenkins Environment Variables Template
# Copy this file to .env and fill in the actual values
# DO NOT commit .env with real values to version control

# ============================================
# GIT CONFIGURATION
# ============================================
# Git repository URL (HTTPS or SSH)
GIT_REPOSITORY_URL=https://github.com/your-username/live-threat-map.git

# Jenkins credentials ID for Git authentication
GIT_CREDENTIALS_ID=git-credentials

# ============================================
# DEPLOYMENT CONFIGURATION (Vercel)
# ============================================
# Get these from Vercel dashboard: Settings > General
VERCEL_TOKEN=your-vercel-token-here
VERCEL_ORG_ID=your-vercel-org-id-here
VERCEL_PROJECT_ID=your-vercel-project-id-here

# ============================================
# DEPLOYMENT CONFIGURATION (AWS S3 - Alternative)
# ============================================
# AWS credentials ID configured in Jenkins
AWS_CREDENTIALS_ID=aws-credentials

# S3 bucket name for deployment
S3_BUCKET_NAME=your-s3-bucket-name

# CloudFront distribution ID (optional, for cache invalidation)
CLOUDFRONT_DISTRIBUTION_ID=your-cloudfront-id

# ============================================
# APPLICATION ENVIRONMENT VARIABLES
# ============================================
# These should be configured in your deployment environment
# (Vercel environment variables, AWS SSM Parameter Store, etc.)
# NOT in Jenkins itself

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cron Job Secret
CRON_SECRET=random-secret-string-for-cron-authentication

# AbuseIPDB API Key (optional - for real threat data)
ABUSEIPDB_API_KEY=your-abuseipdb-api-key

# ============================================
# BUILD CONFIGURATION
# ============================================
# Node.js version to use
NODE_VERSION=18

# ============================================
# NOTIFICATION CONFIGURATION (Optional)
# ============================================
# Slack webhook URL for build notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email for build notifications
NOTIFICATION_EMAIL=devops@example.com
